   "source": [
    "def main():\n",
    "    x = int(input(\"What's is x?\"))\n",
    "    print(f\"The square of x is, {square(x)}\")\n",
    "\n",
    "def square(n):\n",
    "    return n * n\n",
    "\n",
    "main()"
   ]
